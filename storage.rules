rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Public read for all uploaded product, category, and banner images
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == 'gaugehouse1998@gmail.com';
    }
  }
}
